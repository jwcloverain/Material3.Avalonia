<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/klorman/Material3.Avalonia"
             x:Class="Material3.Avalonia.Demo.App">
    <Application.Resources>
        <ResourceDictionary>
            <m3:MaterialSymbolResource x:Key="MdIconMail" Symbol="Mail" />
            <m3:MaterialSymbolsInclude
                x:Key="DynamicSymbols"
                Symbols="VisibilityOff, Check" />
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <m3:MaterialTheme Mode="Light" Variant="TonalSpot" SourceColor="#6750A4" Contrast="Standard" MotionScheme="Expressive"
                            SymbolStyle="Rounded" />
    </Application.Styles>
</Application>
