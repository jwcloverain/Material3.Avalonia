<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m3="https://github.com/klorman/Material3.Avalonia"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="Material3.Avalonia.Demo.Views.Cards" ClipToBounds="False">
    <StackPanel Spacing="{DynamicResource MdSysSpacing100}" Orientation="Vertical">
        <StackPanel Spacing="{DynamicResource MdSysSpacing100}" Orientation="Horizontal">
            <m3:Card Classes="elevated" IsInteractive="False" Height="120" Width="300">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Elevated" />
            </m3:Card>
            <m3:Card Classes="filled" IsInteractive="False" Height="120" Width="300">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Filled" />
            </m3:Card>
            <m3:Card Classes="outlined" IsInteractive="False" Height="120" Width="300">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Outlined" />
            </m3:Card>
        </StackPanel>
        <StackPanel Spacing="{DynamicResource MdSysSpacing100}" Orientation="Horizontal">
            <m3:Card Classes="elevated" IsInteractive="True" Height="120" Width="300">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Elevated Interactive" />
            </m3:Card>
            <m3:Card Classes="filled" IsInteractive="True" Height="120" Width="300">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Filled Interactive" />
            </m3:Card>
            <m3:Card Classes="outlined" IsInteractive="True" Height="120" Width="300">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Outlined Interactive" />
            </m3:Card>
        </StackPanel>
        <StackPanel Spacing="{DynamicResource MdSysSpacing100}" Orientation="Horizontal">
            <m3:Card Classes="elevated" IsInteractive="True" Height="120" Width="300" IsEnabled="False">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Elevated Disabled" />
            </m3:Card>
            <m3:Card Classes="filled" IsInteractive="True" Height="120" Width="300" IsEnabled="False">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Filled Disabled" />
            </m3:Card>
            <m3:Card Classes="outlined" IsInteractive="True" Height="120" Width="300" IsEnabled="False">
                <TextBlock Classes="label-medium" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Outlined Disabled" />
            </m3:Card>
        </StackPanel>
    </StackPanel>
</UserControl>
