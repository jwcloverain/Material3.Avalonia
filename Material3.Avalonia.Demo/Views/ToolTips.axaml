<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="https://github.com/klorman/Material3.Avalonia"
             x:Class="Material3.Avalonia.Demo.Views.ToolTips">
    <StackPanel Width="744"
                Margin="{m3:DynamicThickness MdSysSpacing300}"
                Spacing="{m3:Token MdSysSpacing200}">
        <TextBlock Text="ToolTips and flyouts" m3:Typography.TextStyle="HeadlineMedium" />
        <TextBlock Text="Hover, use Tab, or hold on touch. Move into a rich tooltip to use its actions. Escape dismisses it."
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="{m3:Token MdSysSpacing150}">
            <Button x:Name="PopupHostButton" Content="Popup host: platform" Click="TogglePopupHost" />
            <TextBlock x:Name="ActualPopupHost" Text="Open a tooltip to see its host" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Plain tooltips" m3:Typography.TextStyle="TitleMedium" />
        <WrapPanel>
            <Button Content="Short label" ToolTip.Tip="Save changes" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}" />
            <Button Content="Long text" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}"
                    ToolTip.Tip="Longer localized text wraps without clipping or forcing a fixed tooltip height." />
            <Button Content="Disabled" IsEnabled="False" ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="Connect to a workspace before sharing." Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}" />
        </WrapPanel>

        <TextBlock Text="Rich tooltips" m3:Typography.TextStyle="TitleMedium" />
        <WrapPanel>
            <Button Content="Body only" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="rich-tooltip">
                        An explanation with no subhead or actions.
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="Subhead and body" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}">
                <Button.Flyout>
                    <Flyout m3:FlyoutAssist.Variant="RichToolTip"
                            m3:FlyoutAssist.Subhead="Shared workspace">
                        Keep your team's documents together in one workspace.
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="One action" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="rich-tooltip">
                        <m3:FlyoutAssist.Actions>
                            <Button Content="Got it" Click="DismissToolTip" />
                        </m3:FlyoutAssist.Actions>
                        This rich tooltip has an action and no subhead.
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="Two actions" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="rich-tooltip"
                            m3:FlyoutAssist.Subhead="Share your work">
                        <m3:FlyoutAssist.Actions>
                            <StackPanel Orientation="Horizontal" Spacing="{m3:Token MdSysSpacing100}">
                                <Button Content="Later" Click="DismissToolTip" />
                                <Button Content="Learn more" Click="ShowActionResult" />
                            </StackPanel>
                        </m3:FlyoutAssist.Actions>
                        Invite people to view or edit documents in your workspace.
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Content="Persistent · click" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="rich-tooltip" ShowMode="Standard"
                            m3:FlyoutAssist.Subhead="New sharing settings">
                        <m3:FlyoutAssist.Actions>
                            <Button Content="Dismiss" Click="DismissToolTip" />
                        </m3:FlyoutAssist.Actions>
                        This message stays open when you move the pointer away.
                    </Flyout>
                </Button.Flyout>
            </Button>
        </WrapPanel>

        <Border Background="{m3:Token MdSysSurfaceContainerLowBrush}"
                CornerRadius="{m3:Token MdSysShapeCornerMedium}"
                Padding="{m3:DynamicThickness MdSysSpacing200}">
            <StackPanel Spacing="{m3:Token MdSysSpacing100}" FlowDirection="RightToLeft">
                <TextBlock Text="RTL / טקסט ארוך" m3:Typography.TextStyle="TitleMedium" />
                <Button Content="מידע נוסף" ToolTip.Tip="שמירת השינויים">
                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="rich-tooltip" m3:FlyoutAssist.Subhead="עבודה משותפת">
                            <m3:FlyoutAssist.Actions>
                                <Button Content="סגירה" Click="DismissToolTip" />
                            </m3:FlyoutAssist.Actions>
                            הזמינו אנשים נוספים לצפות במסמכים ולערוך אותם יחד.
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Text="Anchor context and triggers" m3:Typography.TextStyle="TitleMedium" />
        <TextBlock Text="Hover this text: its theme supplies the larger gap" ToolTip.Tip="Text uses an 8-unit gap." />
        <WrapPanel>
            <Button Content="Focus only" ToolTip.Tip="Opened by keyboard navigation."
                    m3:ToolTipAssist.ShowTriggers="Focus" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}" />
            <Button Content="Hover only" ToolTip.Tip="Opened by a hovering pointer."
                    m3:ToolTipAssist.ShowTriggers="Hover" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}" />
            <Button Content="No retained hover" ToolTip.Tip="The anchor follows the pointer immediately."
                    m3:ToolTipAssist.KeepAnchorHovered="False" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}" />
        </WrapPanel>

        <TextBlock Text="Native overrides and ordinary flyouts" m3:Typography.TextStyle="TitleMedium" />
        <WrapPanel>
            <Button Content="Native tooltip behavior" ToolTip.Tip="Avalonia controls the timing."
                    m3:ToolTipAssist.IsMaterialBehaviorEnabled="False" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}" />
            <Button Content="Right placement" ToolTip.Tip="Explicit placement and delay"
                    ToolTip.Placement="Right" ToolTip.VerticalOffset="0" ToolTip.ShowDelay="800" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}" />
            <Button Content="Ordinary flyout · click" Margin="{m3:DynamicThickness MdSysSpacing0 MdSysSpacing0 MdSysSpacing100 MdSysSpacing100}">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="{m3:Token MdSysSpacing100}">
                            <TextBlock Text="Display name" />
                            <TextBox Text="Workspace" />
                            <Button Content="Apply" Click="DismissToolTip" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </WrapPanel>
        <TextBlock x:Name="ActionResult" Text="No action selected" />
        <Button Content="Hold for context menu" ToolTip.Tip="Hover still shows a tooltip.">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Native context action" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <TextBox Text="Touch selection and the native context menu take priority over tooltips."
                 ToolTip.Tip="Select and edit text normally." />
        <Button x:Name="CheckScreenEdgesButton" Content="Check screen edges" Click="ShowEdgeWindow" />
    </StackPanel>
</UserControl>
