<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:attached="clr-namespace:Material3.Avalonia.Attached;assembly=Material3.Avalonia"
             xmlns:controls="clr-namespace:Material3.Avalonia.Attached.Controls;assembly=Material3.Avalonia"
             xmlns:helpers="clr-namespace:Material3.Avalonia.Controls.Helpers;assembly=Material3.Avalonia"
             xmlns:markup="clr-namespace:Material3.Avalonia.Markup;assembly=Material3.Avalonia"
             xmlns:vm="clr-namespace:Material3.Avalonia.Demo.ViewModels"
             x:DataType="vm:CheckBoxesViewModel"
             x:Class="Material3.Avalonia.Demo.Views.CheckBoxes">
    <UserControl.Styles>
        <Style Selector="Border.checkbox-section">
            <Setter Property="Background" Value="{markup:Token MdSysSurfaceContainerLowBrush}" />
            <Setter Property="CornerRadius" Value="{markup:Token MdSysShapeCornerLarge}" />
            <Setter Property="Padding" Value="{markup:DynamicThickness MdSysSpacing300}" />
        </Style>
    </UserControl.Styles>
    <StackPanel MaxWidth="720"
                Margin="{markup:DynamicThickness MdSysSpacing300}"
                Spacing="{markup:Token MdSysSpacing300}">
        <TextBlock Text="Checkboxes" helpers:Typography.TextStyle="HeadlineMedium" />
        <TextBlock Text="Click the indicator, label or space around it. Use Tab, Space and Enter; hold, drag away and rapidly toggle to inspect the ripple and icon transitions."
                   TextWrapping="Wrap" helpers:Typography.TextStyle="BodyMedium" />
        <Border Classes="checkbox-section">
            <StackPanel Spacing="{markup:Token MdSysSpacing100}">
                <TextBlock Text="Selection and error states" helpers:Typography.TextStyle="TitleMedium" />
                <WrapPanel>
                    <CheckBox Content="Unchecked" />
                    <CheckBox Content="Checked" IsChecked="True" />
                    <CheckBox Content="Mixed" IsChecked="{x:Null}" IsThreeState="True" />
                </WrapPanel>
                <WrapPanel>
                    <CheckBox Content="Disabled" IsEnabled="False" />
                    <CheckBox Content="Checked" IsChecked="True" IsEnabled="False" />
                    <CheckBox Content="Mixed" IsChecked="{x:Null}" IsEnabled="False" />
                </WrapPanel>
                <WrapPanel>
                    <CheckBox Content="Error" controls:CheckBoxAssist.IsError="True" />
                    <CheckBox Content="Checked error" IsChecked="True" controls:CheckBoxAssist.IsError="True" />
                    <CheckBox Content="Mixed error" IsChecked="{x:Null}" controls:CheckBoxAssist.IsError="True" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Classes="checkbox-section">
            <StackPanel Spacing="{markup:Token MdSysSpacing100}">
                <TextBlock Text="Click targets and content" helpers:Typography.TextStyle="TitleMedium" />
                <CheckBox Content="Left-aligned target" />
                <CheckBox Content="Stretched target — click the empty space" HorizontalAlignment="Stretch"
                          Background="{markup:Token MdSysSurfaceContainerHighBrush}" />
                <CheckBox Content="A long checkbox label wraps naturally when the available width is limited, while its focus ring stays around the indicator."
                          MaxWidth="320" />
                <CheckBox Content="Right-to-left layout" FlowDirection="RightToLeft" HorizontalAlignment="Stretch" />
                <CheckBox Content="Content template">
                    <CheckBox.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel>
                                <TextBlock Text="{Binding}" />
                                <TextBlock Text="Custom secondary content" helpers:Typography.TextStyle="BodySmall" />
                            </StackPanel>
                        </DataTemplate>
                    </CheckBox.ContentTemplate>
                </CheckBox>
                <CheckBox AutomationProperties.Name="Select this item" ToolTip.Tip="Checkbox without a label" />
                <CheckBox Content="_Access key" />
            </StackPanel>
        </Border>
        <Border Classes="checkbox-section">
            <StackPanel Spacing="{markup:Token MdSysSpacing100}" attached:DensityAssist.Density="Dense5">
                <TextBlock Text="Explicit density" helpers:Typography.TextStyle="TitleMedium" />
                <TextBlock Text="The label stays aligned. Dense3–Dense5 also reduce the circle; the 18 dp indicator stays unchanged."
                           helpers:Typography.TextStyle="BodySmall" TextWrapping="Wrap" />
                <CheckBox Content="Default 48 — parent Dense5 is not inherited" />
                <CheckBox Content="Dense1 — 44" attached:DensityAssist.Density="Dense1" />
                <CheckBox Content="Dense2 — 40" attached:DensityAssist.Density="Dense2" />
                <CheckBox Content="Dense3 — 36" attached:DensityAssist.Density="Dense3" />
                <CheckBox Content="Dense4 — 32" attached:DensityAssist.Density="Dense4" />
                <CheckBox Content="Dense5 — 28" attached:DensityAssist.Density="Dense5" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox AutomationProperties.Name="Default density" />
                    <CheckBox AutomationProperties.Name="Dense1" attached:DensityAssist.Density="Dense1" />
                    <CheckBox AutomationProperties.Name="Dense2" attached:DensityAssist.Density="Dense2" />
                    <CheckBox AutomationProperties.Name="Dense3" attached:DensityAssist.Density="Dense3" />
                    <CheckBox AutomationProperties.Name="Dense4" attached:DensityAssist.Density="Dense4" />
                    <CheckBox AutomationProperties.Name="Dense5" attached:DensityAssist.Density="Dense5" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="checkbox-section">
            <StackPanel Spacing="{markup:Token MdSysSpacing100}">
                <TextBlock Text="Content and size motion" helpers:Typography.TextStyle="TitleMedium" />
                <TextBlock Text="Change several settings rapidly. Tab to the checkbox to watch its focus ring during resizing."
                           TextWrapping="Wrap" helpers:Typography.TextStyle="BodySmall" />
                <WrapPanel ItemSpacing="{markup:Token MdSysSpacing100}">
                    <Button Content="Change text" Click="OnTextClick" />
                    <Button Content="Change template" Click="OnTemplateClick" />
                    <Button Content="Change width" Click="OnWidthClick" />
                    <Button Content="Cycle density" Click="OnDensityClick" />
                </WrapPanel>
                <CheckBox x:Name="MotionOption" Content="Short label" MaxWidth="480" />
                <CheckBox x:Name="RtlMotionOption" Content="Short label" MaxWidth="480" HorizontalAlignment="Right"
                          FlowDirection="RightToLeft" />
            </StackPanel>
        </Border>
        <Border Classes="checkbox-section">
            <StackPanel Spacing="{markup:Token MdSysSpacing100}">
                <TextBlock Text="Related options" helpers:Typography.TextStyle="TitleMedium" />
                <CheckBox Content="Select all notifications" IsChecked="{Binding AllSelected, Mode=OneWay}"
                          Command="{Binding SelectAllCommand}" />
                <StackPanel Margin="{markup:DynamicThickness MdSysSpacing300 MdSysSpacing0 MdSysSpacing0 MdSysSpacing0}">
                    <CheckBox Content="Email" IsChecked="{Binding Email, Mode=TwoWay}" Command="{Binding CountActivationCommand}" />
                    <CheckBox Content="Push" IsChecked="{Binding Push, Mode=TwoWay}" Command="{Binding CountActivationCommand}" />
                    <CheckBox Content="SMS" IsChecked="{Binding Sms, Mode=TwoWay}" Command="{Binding CountActivationCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ActivationText}" helpers:Typography.TextStyle="BodySmall" />
                <CheckBox Content="Native three-state cycle" IsThreeState="True" />
            </StackPanel>
        </Border>
        <Border Classes="checkbox-section">
            <StackPanel Spacing="{markup:Token MdSysSpacing100}">
                <TextBlock Text="Validation and external supporting text" helpers:Typography.TextStyle="TitleMedium" />
                <CheckBox x:Name="ValidatedOption" Content="Delivery notifications" />
                <TextBlock Text="You can change this preference at any time."
                           helpers:Typography.TextStyle="BodySmall" TextWrapping="Wrap" />
                <Button Content="Toggle validation error" Click="OnValidationClick" />
                <CheckBox x:Name="RemappedOption" Content="Local token alias" IsChecked="True" />
                <Button Content="Remap selected colors" Click="OnRemapClick" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
