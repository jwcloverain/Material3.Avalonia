<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="MdSysStatePointerOverOpacity">0.08</x:Double>
    <x:Double x:Key="MdSysStateFocusOpacity">0.1</x:Double>
    <x:Double x:Key="MdSysStatePressedOpacity">0.1</x:Double>
    <x:Double x:Key="MdSysStateDraggedOpacity">0.16</x:Double>
    <Thickness x:Key="MdSysStateFocusIndicatorThickness">3</Thickness>
    <Thickness x:Key="MdSysStateFocusIndicatorOuterOffset">2</Thickness>
</ResourceDictionary>